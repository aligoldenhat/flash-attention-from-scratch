{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure debug",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "debug"],
      "problemMatcher": []
    },
    {
      "label": "build debug",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "debug"],
      "dependsOn": ["configure debug"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
